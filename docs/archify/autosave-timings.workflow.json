    { "id": "ink", "lane": "trigger", "col": 1, "type": "frontend", "label": "インク bake" },
    { "id": "persist", "lane": "hook", "col": 0, "type": "backend", "label": "persist()" },
    { "id": "schedule", "lane": "hook", "col": 1, "type": "backend", "label": "scheduleSave" },
