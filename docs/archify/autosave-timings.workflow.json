    { "id": "commit", "label": "書き込み / 退避", "fromCol": 3, "toCol": 5 }
  ],
  "groups": [
    { "id": "debounce_group", "label": "遅延保存", "lane": "manager", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
